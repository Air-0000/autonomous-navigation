#VRML_SIM R2025a utf8

WorldInfo {
  info [
    "无人系统智能导航仿真环境"
  ]
  title "UAV Navigation"
  basicTimeStep 32
  FPS 30
}

Viewpoint {
  orientation -0.3 0.95 0.1 1.1
  position 5 8 5
}

Background {
  skyColor 0.8 0.8 0.9
}

DEF GROUND Solid {
  translation 0 -0.01 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        metalness 0
        roughness 1
      }
      geometry Plane {
        size 10 10
      }
    }
  ]
  name "ground"
  boundingObject Plane {
    size 10 10
  }
}

Robot {
  translation 0 0.5 0
  children [
    Camera {
      width 640
      height 480
      near 0.1
      far 100
    }
    Gyro {
    }
    GPS {
    }
    Compass {
    }
