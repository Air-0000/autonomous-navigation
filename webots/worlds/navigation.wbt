      appearance PBRAppearance {
        baseColor 0.2 0.2 0.2
        metalness 0
        roughness 1
      }
      geometry Box {
        size 0.3 0.1 0.3
      }
    }
    Propeller {
    }
    Propeller {
    }
    Propeller {
    }
    Propeller {
    }
  ]
  name "uav"
  controller "uav_navigation"
}

